<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Session Snapshots</h1>
    <div class="flex space-x-3">
      <%= link_to "New Snapshot", new_project_session_snapshot_path(@project), 
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200" %>
      <%= link_to "Back to Project", project_path(@project), 
          class: "bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200" %>
    </div>
  </div>

  <% if @snapshots.any? %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @snapshots.each do |snapshot| %>
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-lg font-semibold text-gray-900"><%= snapshot.display_name %></h3>
            <span class="text-sm text-gray-500">
              <%= time_ago_in_words(snapshot.created_at) %> ago
            </span>
          </div>
          
          <% if snapshot.description.present? %>
            <p class="text-gray-600 mb-4"><%= snapshot.description %></p>
          <% end %>
          
          <div class="flex items-center space-x-4 text-sm text-gray-500 mb-4">
            <span>
              <i class="fas fa-file text-blue-500"></i>
              <%= pluralize(snapshot.file_count, 'file') %>
            </span>
            <span>
              <i class="fas fa-hdd text-green-500"></i>
              <%= number_to_human_size(snapshot.archive_size) %>
            </span>
          </div>
          
          <div class="flex space-x-2">
            <%= button_to "Restore", restore_project_session_snapshot_path(@project, snapshot), 
                method: :post,
                class: "bg-green-600 hover:bg-green-700 text-white text-sm font-medium py-2 px-3 rounded transition duration-200",
                data: { confirm: "This will replace your current workspace. Are you sure?" } %>
            
            <%= link_to "View", project_session_snapshot_path(@project, snapshot), 
                class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-3 rounded transition duration-200" %>
            
            <%= button_to "Delete", project_session_snapshot_path(@project, snapshot), 
                method: :delete,
                class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium py-2 px-3 rounded transition duration-200",
                data: { confirm: "Are you sure you want to delete this snapshot?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <i class="fas fa-camera text-6xl"></i>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No snapshots yet</h3>
      <p class="text-gray-500 mb-6">Create your first snapshot to save your current workspace state.</p>
      <%= link_to "Create Snapshot", new_project_session_snapshot_path(@project), 
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition duration-200" %>
    </div>
  <% end %>
</div>
