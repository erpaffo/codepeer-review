<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @snapshot.display_name %></h1>
        <p class="text-gray-600 mt-2">Session snapshot details</p>
      </div>
      <div class="flex space-x-3">
        <%= button_to "Restore", restore_project_session_snapshot_path(@project, @snapshot), 
            method: :post,
            class: "bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200",
            data: { confirm: "This will replace your current workspace. Are you sure?" } %>
        <%= link_to "Back to Snapshots", project_session_snapshots_path(@project), 
            class: "bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200" %>
      </div>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Informazioni principali -->
    <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Snapshot Information</h2>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Name</label>
          <p class="mt-1 text-sm text-gray-900"><%= @snapshot.name %></p>
        </div>
        
        <% if @snapshot.description.present? %>
          <div>
            <label class="block text-sm font-medium text-gray-700">Description</label>
            <p class="mt-1 text-sm text-gray-900"><%= @snapshot.description %></p>
          </div>
        <% end %>
        
        <div>
          <label class="block text-sm font-medium text-gray-700">Created</label>
          <p class="mt-1 text-sm text-gray-900">
            <%= @snapshot.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            <span class="text-gray-500 ml-2">(<%= time_ago_in_words(@snapshot.created_at) %> ago)</span>
          </p>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700">Project</label>
          <p class="mt-1 text-sm text-gray-900">
            <%= link_to @project.title, project_path(@project), class: "text-blue-600 hover:text-blue-800" %>
          </p>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700">Created by</label>
          <p class="mt-1 text-sm text-gray-900">
            <%= link_to @snapshot.user.name, user_path(@snapshot.user), class: "text-blue-600 hover:text-blue-800" %>
          </p>
        </div>
      </div>
    </div>

    <!-- Statistiche -->
    <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Archive Statistics</h2>
      
      <div class="space-y-4">
        <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
          <div class="flex items-center">
            <i class="fas fa-file text-blue-500 mr-3"></i>
            <span class="text-sm font-medium text-blue-900">Files included</span>
          </div>
          <span class="text-lg font-semibold text-blue-900"><%= @snapshot.file_count %></span>
        </div>
        
        <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
          <div class="flex items-center">
            <i class="fas fa-hdd text-green-500 mr-3"></i>
            <span class="text-sm font-medium text-green-900">Archive size</span>
          </div>
          <span class="text-lg font-semibold text-green-900"><%= number_to_human_size(@snapshot.archive_size) %></span>
        </div>
        
        <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg">
          <div class="flex items-center">
            <i class="fas fa-clock text-purple-500 mr-3"></i>
            <span class="text-sm font-medium text-purple-900">Age</span>
          </div>
          <span class="text-lg font-semibold text-purple-900"><%= time_ago_in_words(@snapshot.created_at) %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Azioni -->
  <div class="mt-8 bg-white rounded-lg shadow-md border border-gray-200 p-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Actions</h2>
    
    <div class="flex flex-wrap gap-3">
      <%= button_to "Restore this snapshot", restore_project_session_snapshot_path(@project, @snapshot), 
          method: :post,
          class: "bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-6 rounded-lg transition duration-200",
          data: { confirm: "This will replace your current workspace with the files from this snapshot. Are you sure?" } %>
      
      <%= link_to "Go to Shell", project_run_shell_path(@project), 
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition duration-200" %>
      
      <%= button_to "Delete snapshot", project_session_snapshot_path(@project, @snapshot), 
          method: :delete,
          class: "bg-red-600 hover:bg-red-700 text-white font-medium py-3 px-6 rounded-lg transition duration-200",
          data: { confirm: "Are you sure you want to delete this snapshot? This action cannot be undone." } %>
    </div>
    
    <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <div class="flex">
        <div class="flex-shrink-0">
          <i class="fas fa-exclamation-triangle text-yellow-400"></i>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">Important</h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p>Restoring a snapshot will replace your current workspace files. Make sure to save any important changes before proceeding.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
