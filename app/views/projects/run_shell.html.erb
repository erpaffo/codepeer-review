<% content_for :title, @project.title %>
<% if @project %>
  <div class="flex h-screen bg-gray-900">
    <!-- Sidebar con lista file e editor -->
    <div class="w-1/2 flex flex-col bg-gray-800 border-r border-gray-700">
      <!-- Header del progetto -->
      <div class="p-4 bg-gray-700 border-b border-gray-600">
        <h1 class="text-xl font-semibold text-white mb-2"><%= @project.title %></h1>
        <p class="text-gray-300 text-sm"><%= @project.description %></p>
      </div>

      <!-- Lista dei file -->
      <div class="flex-1 overflow-y-auto">
        <div class="p-4 border-b border-gray-600">
          <h2 class="text-lg font-semibold text-white mb-3">Project Files</h2>
          <div class="space-y-2">
            <% @project.project_files.each do |file| %>
              <div class="file-item bg-gray-700 hover:bg-gray-600 rounded-lg p-3 cursor-pointer transition-colors duration-200" 
                   data-file-id="<%= file.id %>" 
                   data-file-name="<%= file.file_identifier %>">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300 font-medium"><%= file.file_identifier %></span>
                  </div>
                  <div class="flex space-x-2">
                    <button class="edit-file-btn bg-blue-600 text-white px-2 py-1 rounded text-xs hover:bg-blue-500 transition-colors duration-200">
                      Edit
                    </button>
                    <button class="run-file-btn bg-green-600 text-white px-2 py-1 rounded text-xs hover:bg-green-500 transition-colors duration-200">
                      Run
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Editor di testo -->
        <div class="flex-1 flex flex-col">
          <div class="p-4 border-b border-gray-600">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-white">Code Editor</h3>
              <div class="flex space-x-2">
                <select id="theme-select" class="bg-gray-700 text-gray-300 text-sm rounded px-2 py-1 border border-gray-600">
                  <option value="vs-dark">Dark Theme</option>
                  <option value="vs-light">Light Theme</option>
                  <option value="hc-black">High Contrast</option>
                </select>
                <input type="number" id="font-size" value="14" min="8" max="24" class="bg-gray-700 text-gray-300 text-sm rounded px-2 py-1 border border-gray-600 w-16">
              </div>
            </div>
            <div class="flex space-x-2">
              <button id="save-file" class="bg-teal-600 text-white py-2 px-4 rounded-lg text-sm hover:bg-teal-500 transition-colors duration-200">Save File</button>
              <button id="run-code" class="bg-blue-600 text-white py-2 px-4 rounded-lg text-sm hover:bg-blue-500 transition-colors duration-200">Run Code</button>
              <button id="new-file" class="bg-purple-600 text-white py-2 px-4 rounded-lg text-sm hover:bg-purple-500 transition-colors duration-200">New File</button>
              <button id="sync-files" class="bg-orange-600 text-white py-2 px-4 rounded-lg text-sm hover:bg-orange-500 transition-colors duration-200">Sync Files</button>
            </div>
          </div>
          
          <!-- Container dell'editor -->
          <div id="code-editor" class="flex-1 bg-gray-900"></div>
          
          <!-- Output del codice -->
          <div id="code-output" class="h-32 bg-gray-800 border-t border-gray-600 p-3 hidden">
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-semibold text-white">Code Output</h4>
              <button id="clear-output" class="text-gray-400 hover:text-white text-sm">Clear</button>
            </div>
            <div id="output-content" class="text-gray-300 text-sm font-mono overflow-y-auto h-full"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Terminal -->
    <div class="w-1/2 flex flex-col bg-gray-900">
      <!-- Header del terminale -->
      <div class="p-4 bg-gray-800 border-b border-gray-700">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-lg font-semibold text-white">Interactive Terminal</h2>
          <div class="flex items-center">
            <span class="status-indicator connecting" id="terminal-status"></span>
            <span class="text-gray-300 text-sm" id="terminal-status-text">Connecting...</span>
          </div>
        </div>
        <p class="text-gray-300 text-sm">Execute commands and run your project files</p>
      </div>

      <!-- Loading Spinner -->
      <div id="terminal-loading" class="flex items-center justify-center bg-gray-800 text-white p-4" style="height: 500px;">
        <svg class="animate-spin h-8 w-8 text-blue-400 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
        </svg>
        <span>Loading terminal...</span>
      </div>

      <!-- Terminal Container -->
      <div id="terminal" data-project-id="<%= @project.id %>" class="flex-1 bg-gray-800 text-white p-4" style="display: none;"></div>
    </div>
  </div>

  <!-- Modal per nuovo file -->
  <div id="new-file-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-gray-800 rounded-lg p-6 w-full max-w-md">
        <h3 class="text-xl font-semibold text-white mb-4">Create New File</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-gray-300 text-sm mb-2">File Name</label>
            <input type="text" id="new-file-name" class="w-full bg-gray-700 text-white p-2 rounded border border-gray-600 focus:border-blue-500">
          </div>
          <div>
            <label class="block text-gray-300 text-sm mb-2">Extension</label>
            <select id="new-file-extension" class="w-full bg-gray-700 text-white p-2 rounded border border-gray-600 focus:border-blue-500">
              <option value="py">.py (Python)</option>
              <option value="js">.js (JavaScript)</option>
              <option value="rb">.rb (Ruby)</option>
              <option value="c">.c (C)</option>
              <option value="cpp">.cpp (C++)</option>
              <option value="java">.java (Java)</option>
              <option value="rs">.rs (Rust)</option>
              <option value="txt">.txt (Text)</option>
            </select>
          </div>
        </div>
        <div class="flex space-x-3 mt-6">
          <button id="create-file-btn" class="bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-500 transition-colors duration-200">Create</button>
          <button id="cancel-new-file" class="bg-gray-600 text-white py-2 px-4 rounded hover:bg-gray-500 transition-colors duration-200">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <%= javascript_pack_tag 'interactive_shell' %>
  <%= javascript_pack_tag 'project_editor' %>
<% else %>
  <div class="p-6">
    <p>Project not found.</p>
  </div>
<% end %>
